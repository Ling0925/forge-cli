{
  "name": "@forge/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Forge terminal client: Ink chat, one-shot runs, sessions and local-host attach",
  "type": "module",
  "bin": {
    "forge": "dist/cli.mjs"
  },
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "node scripts/build-core.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm verify:boundaries && pnpm typecheck && pnpm test",
    "cli": "node dist/cli.mjs"
  },
  "dependencies": {
    "@forge/core": "file:../forge-core",
    "cli-highlight": "^2.1.11",
    "ink": "6.6.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.0.0",
    "string-width": "8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "esbuild": "^0.25.3",
    "playwright": "^1.51.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "zod": "^3.24.2"
  }
}
