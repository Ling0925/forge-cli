diff --git a/build/text-cache.js b/build/text-cache.js
new file mode 100644
index 0000000000000000000000000000000000000000..b0941d27b911954ec871cc56d67f7f1c4ba27a7d
--- /dev/null
+++ b/build/text-cache.js
@@ -0,0 +1,34 @@
+// Forge local patch: bound process-lifetime text caches for streaming terminals.
+// Cost is a conservative UTF-16 estimate, not an exact V8 heap measurement.
+export default class TextCache {
+    entries = new Map();
+    retainedBytes = 0;
+    constructor(maxEntries = 2048, maxBytes = 2 * 1024 * 1024) {
+        this.maxEntries = maxEntries;
+        this.maxBytes = maxBytes;
+    }
+    get(key) {
+        const entry = this.entries.get(key);
+        if (!entry) return undefined;
+        this.entries.delete(key);
+        this.entries.set(key, entry);
+        return entry.value;
+    }
+    set(key, value) {
+        const previous = this.entries.get(key);
+        if (previous) {
+            this.retainedBytes -= previous.cost;
+            this.entries.delete(key);
+        }
+        const cost = 256 + key.length * 2 + (typeof value === 'string' ? value.length * 2 : 32);
+        // Oversized input is still rendered, just never retained by this cache.
+        if (this.maxEntries < 1 || cost > this.maxBytes) return;
+        while (this.entries.size >= this.maxEntries || this.retainedBytes + cost > this.maxBytes) {
+            const oldest = this.entries.keys().next().value;
+            this.retainedBytes -= this.entries.get(oldest).cost;
+            this.entries.delete(oldest);
+        }
+        this.entries.set(key, { value, cost });
+        this.retainedBytes += cost;
+    }
+}
