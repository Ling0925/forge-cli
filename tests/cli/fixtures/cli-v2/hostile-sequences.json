{
  "description": "Hostile terminal sequences that must be sanitized, not executed",
  "cases": [
    {
      "id": "osc-title",
      "input": "\u001b]0;Injected Title\u0007Normal text after OSC",
      "expect_no_execute": true,
      "expect_visible": "Normal text after OSC"
    },
    {
      "id": "osc-clipboard",
      "input": "\u001b]52;c;ZWNobyBoYWNrZWQ=\u0007Clipboard injection attempt",
      "expect_no_execute": true,
      "expect_visible": "Clipboard injection attempt"
    },
    {
      "id": "csi-cursor-move",
      "input": "\u001b[2J\u001b[H\u001b[31mVisible red text\u001b[0m",
      "expect_no_execute": true,
      "expect_visible": "Visible red text"
    },
    {
      "id": "dcs-string",
      "input": "\u001bPq#0;2;0;0;0#1;2;100;0;0#2;2;0;100;0\\\u001b\\End of DCS",
      "expect_no_execute": true,
      "expect_visible": "End of DCS"
    },
    {
      "id": "c1-csi-split",
      "input": "Before\u009b31mHidden C1\u001b[0mAfter",
      "expect_no_execute": true,
      "expect_visible_contains": ["Before", "After"]
    },
    {
      "id": "split-paste-marker",
      "input": "Normal\u001b[200~injected\u001b[201~text",
      "expect_no_execute": true,
      "description": "Split bracketed paste markers inside content must not toggle paste mode"
    },
    {
      "id": "cr-backspace-manipulation",
      "input": "Visible\r\u001b[KHidden\rShadows",
      "expect_no_execute": true,
      "description": "CR/erase-line sequences must not hide real content"
    },
    {
      "id": "long-line-overflow",
      "input": "",
      "expect_no_execute": true,
      "expect_bounded": true,
      "max_bytes": 8192
    }
  ]
}
